# Supabase (project settings > API). The browser uses the anon key for auth only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection used by Drizzle (server-side only). Use the
# session or transaction pooler URL from Supabase; port 6543 for the pooler.
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Resend. The same API key is also the SMTP password in Supabase Auth > SMTP.
RESEND_API_KEY=
RESEND_FROM_EMAIL="La Casa de Grado <no-reply@example.com>"

# Cloudflare R2 (private bucket, S3-compatible API token).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lacasadegrado

# Business WhatsApp in wa.me format: country code + number, digits only.
NEXT_PUBLIC_WHATSAPP_NUMBER=584120000000
# Canonical origin, no trailing slash. Used in emails and redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Inbox that receives support form messages (placeholder until the business has one).
SUPPORT_NOTIFY_EMAIL=soporte@lacasadegrado.com
